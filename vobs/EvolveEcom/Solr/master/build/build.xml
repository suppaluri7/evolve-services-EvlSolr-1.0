<?xml version="1.0" encoding="UTF-8"?>
<project name="EvlSolrMaster" default="tar">
	<dirname property="ant.file.EvlSolrMaster.dir" file="${ant.file.EvlSolrMaster}"/>
	<dirname property="component" file="${ant.file.EvlSolrMaster.dir}"/>
	<dirname property="ucm_component" file="${component}"/>
	<dirname property="VOB" file="${component}"/>
	<dirname property="VOB.root" file="${VOB}"/>
	<property name="build.common" location="${ucm_component}/build"/>
	<property name="common.xml" location="${build.common}/common.xml"/>
	<import file="${common.xml}"/>
	
	<target name="pre-init" description="EvlSolrMaster pre-initialization.">
		<!--<property name="build.dir" location="${ant.file.EvlSolrMaster.dir}"/> -->
		<property name="build.dir" location="${build.common}"/>
		<property name="project.properties.dir" location="${build.common}"/>
		<property name="solr.control" location="master"/>
	</target>

	<target depends="init" name="tgz" description="Create compressed tar file">
		<project-tgz src="${component}/dev" tgz="${component}/dev/${scm.deploy.name}.tgz"/>
		<project-tgz src="${component}/cert" tgz="${component}/cert/${scm.deploy.name}.tgz"/>
		<project-tgz src="${component}/stage" tgz="${component}/stage/${scm.deploy.name}.tgz"/>
		<project-tgz src="${component}/prod" tgz="${component}/prod/${scm.deploy.name}.tgz"/>
		<project-tgz/>
		<delete file="${component}/dev/${scm.deploy.name}.tgz"/>
		<delete file="${component}/cert/${scm.deploy.name}.tgz"/>
		<delete file="${component}/stage/${scm.deploy.name}.tgz"/>
		<delete file="${component}/prod/${scm.deploy.name}.tgz"/>
	</target>

	<target depends="tgz" name="tar" description="Create Deployment Unit">
		<release-tar />
	</target>

</project>
