<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Configure PUBLIC "-//Jetty//Configure//EN" "http://www.eclipse.org/jetty/configure.dtd">
<Configure id="Server" class="org.eclipse.jetty.server.Server">

  <Call name="setAttribute">
    <Arg>org.eclipse.jetty.webapp.configuration</Arg>
    <Arg>
        <Array type="java.lang.String">
            <Item>org.eclipse.jetty.webapp.WebInfConfiguration</Item>
            <Item>org.eclipse.jetty.webapp.WebXmlConfiguration</Item>
            <Item>org.eclipse.jetty.webapp.MetaInfConfiguration</Item>
            <Item>org.eclipse.jetty.webapp.FragmentConfiguration</Item>
            <Item>org.eclipse.jetty.plus.webapp.EnvConfiguration</Item>
            <Item>org.eclipse.jetty.plus.webapp.PlusConfiguration</Item>
            <Item>org.eclipse.jetty.webapp.JettyWebXmlConfiguration</Item>
            <Item>org.eclipse.jetty.webapp.TagLibConfiguration</Item>
        </Array>
    </Arg>
  </Call>

  <New class="org.eclipse.jetty.plus.jndi.Resource" id="evolve">
    <Arg/>
    <Arg>jdbc/evolve</Arg>
    <Arg>
        <!--  <Set name="URL">jdbc:oracle:thin:@localhost:1522/EVDEVCS</Set> --> 
        <!--  <Set name="URL">jdbc:oracle:thin:@localhost:1523/EVPCRTCS</Set> -->        
      <!--<New class="oracle.jdbc.pool.OracleDataSource">
        <Set name="DriverType">thin</Set>
                 
        <Set name="URL"><Property name="evolve.db.url" /></Set>
        <Set name="User"><Property name="evolve.db.username" /></Set>
        <Set name="Password"><Property name="evolve.db.password" /></Set>       
        <Set name="connectionCachingEnabled">true</Set>
        <Set name="connectionCacheProperties">
          <New class="java.util.Properties">
            <Call name="setProperty">
              <Arg>MinLimit</Arg>
              <Arg>5</Arg>
            </Call>
          </New>
       </Set>
      </New> -->
      
      <New class="org.apache.tomcat.jdbc.pool.DataSource">
        <Set name="driverClassName">oracle.jdbc.OracleDriver</Set>
        <Set name="url"><Property name="evolve.db.url" /></Set>
        <Set name="username"><Property name="evolve.db.username" /></Set>
        <Set name="password"><Property name="evolve.db.password" /></Set>
        <Set name="validationQuery">SELECT 1 FROM DUAL</Set>
        <Set name="initialSize">10</Set>
        <Set name="maxActive">30</Set>
        <Set name="maxIdle">30</Set>
        <Set name="minIdle">10</Set>
        <Set name="testOnBorrow">true</Set>
        <Set name="testWhileIdle">true</Set>
        <Set name="minEvictableIdleTimeMillis">12000</Set>
        <Set name="timeBetweenEvictionRunsMillis">6000</Set>
        <Set name="jdbcInterceptors">ConnectionState;StatementFinalizer;StatementDecoratorInterceptor;SlowQueryReport(threshold=2000);ResetAbandonedTimer</Set>
        <Set name="logAbandoned">true</Set>
        <Set name="suspectTimeout">300</Set>
     </New>
    </Arg>
  </New>
</Configure>